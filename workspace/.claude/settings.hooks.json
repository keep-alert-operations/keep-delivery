{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "script=\"$CLAUDE_PROJECT_DIR/keep-delivery/scripts/smoke_gate.py\"; [ -f \"$script\" ] || exit 0; \"{python}\" -B \"$script\" session-start",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "script=\"$CLAUDE_PROJECT_DIR/keep-delivery/scripts/smoke_gate.py\"; [ -f \"$script\" ] || exit 0; \"{python}\" -B \"$script\" pre-tool-use",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "script=\"$CLAUDE_PROJECT_DIR/keep-delivery/scripts/smoke_gate.py\"; [ -f \"$script\" ] || exit 0; \"{python}\" -B \"$script\" stop",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
