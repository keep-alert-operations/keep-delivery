{
  "apiVersion": "template.openshift.io/v1",
  "kind": "Template",
  "metadata": {
    "name": "keep-private-ingestion"
  },
  "parameters": [
    {
      "name": "INGESTION_IMAGE",
      "required": true
    },
    {
      "name": "INGRESS_CONFIG_SECRET",
      "required": true
    },
    {
      "name": "INGRESS_BINDING_SECRET",
      "required": true
    },
    {
      "name": "SERVICE_ACCOUNT",
      "required": true
    },
    {
      "name": "CPU_REQUEST",
      "required": true
    },
    {
      "name": "CPU_LIMIT",
      "required": true
    },
    {
      "name": "MEMORY_REQUEST",
      "required": true
    },
    {
      "name": "MEMORY_LIMIT",
      "required": true
    },
    {
      "name": "EPHEMERAL_STORAGE_REQUEST",
      "required": true
    },
    {
      "name": "EPHEMERAL_STORAGE_LIMIT",
      "required": true
    },
    {
      "name": "TMP_SIZE_LIMIT",
      "required": true
    },
    {
      "name": "REPLICAS",
      "required": true
    },
    {
      "name": "GLOBAL_TENANT_ID",
      "required": true
    },
    {
      "name": "CLOCK_HEALTH_CONFIGMAP",
      "required": true
    }
  ],
  "objects": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "keep-private-ingestion"
      },
      "spec": {
        "replicas": "${{REPLICAS}}",
        "selector": {
          "matchLabels": {
            "app": "keep-private-ingestion"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "keep-private-ingestion",
              "app.kubernetes.io/part-of": "keep"
            }
          },
          "spec": {
            "serviceAccountName": "${SERVICE_ACCOUNT}",
            "automountServiceAccountToken": false,
            "terminationGracePeriodSeconds": 60,
            "containers": [
              {
                "name": "api",
                "ports": [
                  {
                    "name": "tls",
                    "containerPort": 8443
                  }
                ],
                "env": [
                  {
                    "name": "KEEP_ROLE",
                    "value": "private-ingestion"
                  },
                  {
                    "name": "KEEP_BIND_HOST",
                    "value": "0.0.0.0"
                  },
                  {
                    "name": "KEEP_BIND_PORT",
                    "value": "8443"
                  },
                  {
                    "name": "KEEP_GLOBAL_TENANT_ID",
                    "value": "${GLOBAL_TENANT_ID}"
                  },
                  {
                    "name": "KEEP_CLOCK_HEALTH_FILE",
                    "value": "/run/keep-clock/health.json"
                  }
                ],
                "livenessProbe": {
                  "tcpSocket": {
                    "port": "tls"
                  },
                  "timeoutSeconds": 5,
                  "periodSeconds": 10,
                  "failureThreshold": 3
                },
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "python",
                      "-m",
                      "keep.probes",
                      "private-ingestion"
                    ]
                  },
                  "timeoutSeconds": 8,
                  "periodSeconds": 10,
                  "failureThreshold": 1
                },
                "startupProbe": {
                  "tcpSocket": {
                    "port": "tls"
                  },
                  "timeoutSeconds": 5,
                  "periodSeconds": 10,
                  "failureThreshold": 30
                },
                "image": "${INGESTION_IMAGE}",
                "envFrom": [
                  {
                    "secretRef": {
                      "name": "${INGRESS_CONFIG_SECRET}"
                    }
                  }
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "runAsNonRoot": true,
                  "seccompProfile": {
                    "type": "RuntimeDefault"
                  },
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "${CPU_REQUEST}",
                    "memory": "${MEMORY_REQUEST}",
                    "ephemeral-storage": "${EPHEMERAL_STORAGE_REQUEST}"
                  },
                  "limits": {
                    "cpu": "${CPU_LIMIT}",
                    "memory": "${MEMORY_LIMIT}",
                    "ephemeral-storage": "${EPHEMERAL_STORAGE_LIMIT}"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "bindings",
                    "mountPath": "/etc/keep",
                    "readOnly": true
                  },
                  {
                    "name": "clock-health",
                    "mountPath": "/run/keep-clock",
                    "readOnly": true
                  }
                ],
                "command": [
                  "python",
                  "-m",
                  "keep.private_ingestion"
                ]
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "${TMP_SIZE_LIMIT}"
                }
              },
              {
                "name": "bindings",
                "secret": {
                  "secretName": "${INGRESS_BINDING_SECRET}"
                }
              },
              {
                "name": "clock-health",
                "configMap": {
                  "name": "${CLOCK_HEALTH_CONFIGMAP}"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "keep-private-ingestion"
      },
      "spec": {
        "selector": {
          "app": "keep-private-ingestion"
        },
        "ports": [
          {
            "name": "tls",
            "port": 8443,
            "targetPort": "tls"
          }
        ]
      }
    }
  ]
}
