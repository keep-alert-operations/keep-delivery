{
  "apiVersion": "template.openshift.io/v1",
  "kind": "Template",
  "metadata": {
    "name": "appchi-worker"
  },
  "parameters": [
    {
      "name": "BACKEND_IMAGE",
      "required": true
    },
    {
      "name": "CONFIG_SECRET",
      "required": true
    },
    {
      "name": "BINDING_SECRET",
      "required": true
    },
    {
      "name": "SERVICE_ACCOUNT",
      "required": true
    },
    {
      "name": "CPU_REQUEST",
      "required": true
    },
    {
      "name": "CPU_LIMIT",
      "required": true
    },
    {
      "name": "MEMORY_REQUEST",
      "required": true
    },
    {
      "name": "MEMORY_LIMIT",
      "required": true
    },
    {
      "name": "EPHEMERAL_STORAGE_REQUEST",
      "required": true
    },
    {
      "name": "EPHEMERAL_STORAGE_LIMIT",
      "required": true
    },
    {
      "name": "TMP_SIZE_LIMIT",
      "required": true
    },
    {
      "name": "REPLICAS",
      "required": true
    },
    {
      "name": "WORKER_ROLE",
      "required": true
    },
    {
      "name": "HEARTBEAT_MAX_AGE_SECONDS",
      "required": true
    }
  ],
  "objects": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "appchi-${WORKER_ROLE}"
      },
      "spec": {
        "replicas": "${{REPLICAS}}",
        "selector": {
          "matchLabels": {
            "app": "appchi-${WORKER_ROLE}"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "appchi-${WORKER_ROLE}",
              "app.kubernetes.io/part-of": "appchi"
            }
          },
          "spec": {
            "serviceAccountName": "${SERVICE_ACCOUNT}",
            "automountServiceAccountToken": false,
            "terminationGracePeriodSeconds": 60,
            "containers": [
              {
                "name": "worker",
                "command": [
                  "python",
                  "-m",
                  "appchi.worker",
                  "${WORKER_ROLE}"
                ],
                "env": [
                  {
                    "name": "APPCHI_WORKER_HEALTH_PATH",
                    "value": "/tmp/worker-health.json"
                  }
                ],
                "livenessProbe": {
                  "exec": {
                    "command": [
                      "python",
                      "-m",
                      "appchi.worker_health",
                      "live",
                      "--max-age",
                      "${HEARTBEAT_MAX_AGE_SECONDS}"
                    ]
                  },
                  "timeoutSeconds": 5,
                  "periodSeconds": 10,
                  "failureThreshold": 3
                },
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "python",
                      "-m",
                      "appchi.worker_health",
                      "ready",
                      "--max-age",
                      "${HEARTBEAT_MAX_AGE_SECONDS}"
                    ]
                  },
                  "timeoutSeconds": 5,
                  "periodSeconds": 10,
                  "failureThreshold": 1
                },
                "image": "${BACKEND_IMAGE}",
                "envFrom": [
                  {
                    "secretRef": {
                      "name": "${CONFIG_SECRET}"
                    }
                  }
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "runAsNonRoot": true,
                  "seccompProfile": {
                    "type": "RuntimeDefault"
                  },
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "${CPU_REQUEST}",
                    "memory": "${MEMORY_REQUEST}",
                    "ephemeral-storage": "${EPHEMERAL_STORAGE_REQUEST}"
                  },
                  "limits": {
                    "cpu": "${CPU_LIMIT}",
                    "memory": "${MEMORY_LIMIT}",
                    "ephemeral-storage": "${EPHEMERAL_STORAGE_LIMIT}"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "bindings",
                    "mountPath": "/etc/appchi",
                    "readOnly": true
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "${TMP_SIZE_LIMIT}"
                }
              },
              {
                "name": "bindings",
                "secret": {
                  "secretName": "${BINDING_SECRET}"
                }
              }
            ]
          }
        }
      }
    }
  ]
}
